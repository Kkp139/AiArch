{
  "name": "pronex-archai",
  "version": "1.0.0",
  "private": true,
  "description": "ProNex-ArchAI Studio Collaboration Portal",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "node ./node_modules/tsx/dist/cli.mjs watch apps/api/src/server.ts",
    "dev:web": "node ./node_modules/vite/bin/vite.js apps/web",
    "dev:worker": "node ./node_modules/tsx/dist/cli.mjs watch apps/worker/src/worker.ts",
    "build": "node ./node_modules/typescript/bin/tsc --build",
    "build:web": "node ./node_modules/vite/bin/vite.js build apps/web && node ./scripts/sync-dist.js",
    "test": "node ./node_modules/vitest/vitest.mjs run"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
