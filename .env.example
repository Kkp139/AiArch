# ==============================================================================
# ProNex-ArchAI — Master Environment Variables Template (.env.example)
# Duplicate this file to .env.development, .env.test, or .env.production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STUDIO & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
STUDIO_NAME="A&B Design"
STUDIO_DOMAIN="localhost"
API_URL="http://localhost:4000/api"
CLIENT_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL 16) & CACHE (Redis 7)
# ------------------------------------------------------------------------------
# Local Docker or Cloud (Neon, Supabase, AWS RDS, etc.)
DB_PASSWORD="pronex_secret_password"
DATABASE_URL="postgres://pronex_admin:pronex_secret_password@localhost:5432/pronex_archai"

# BullMQ Queue and Socket session cache
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# 64-character hex secret for signing JWT tokens (generate via: openssl rand -hex 32)
JWT_SECRET="EXAMPLE"
SESSION_SECRET="EXAMPLE"
OTP_EXPIRY_MINUTES=10

# ------------------------------------------------------------------------------
# 4. CLOUD OBJECT STORAGE (AWS S3 or Cloudflare R2)
# Cloudflare R2 is recommended (Zero egress fees, S3 compatible)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="s3" # Options: 's3' or 'cloudflare_r2' or 'local'
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto" # 'auto' for Cloudflare R2, 'ap-south-1' (Mumbai) for AWS S3
S3_BUCKET_NAME="example"
S3_ACCESS_KEY_ID="your_s3_or_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_s3_or_r2_secret_access_key"
S3_PUBLIC_DOMAIN="https://vault.abdesign.com" # Optional CDN domain for public assets

# ------------------------------------------------------------------------------
# 5. WHATSAPP BUSINESS OTP ENGINE
# For Client Leader & Viewer sign-in verification
# ------------------------------------------------------------------------------
# Set to 'true' in development/testing to simulate OTP dispatch (always logs OTP to console or accepts 123456)
WHATSAPP_ENABLE_MOCK=true
WHATSAPP_PROVIDER="meta" # Options: 'meta' (Meta Cloud API) or 'twilio'

# Meta WhatsApp Cloud API credentials (https://developers.facebook.com)
META_WA_PHONE_NUMBER_ID="your_meta_phone_number_id"
META_WA_BUSINESS_ACCOUNT_ID="your_meta_business_account_id"
META_WA_ACCESS_TOKEN="your_permanent_system_user_token"
META_WA_TEMPLATE_NAME="pronex_login_otp"

# Twilio WhatsApp Alternative (Optional: if not using Meta directly)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ------------------------------------------------------------------------------
# 6. WEB PUSH NOTIFICATIONS (VAPID Keys)
# Free browser push notifications for Chrome, Edge, Safari & Mobile PWAs
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:admin@abdesign.com"

# ------------------------------------------------------------------------------
# 7. OPTIONAL EMAIL ALERTS (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="admin@abdesign.com"
SMTP_PASS="your_app_specific_password"
SMTP_FROM="A&B Design Portal <notifications@abdesign.com>"
